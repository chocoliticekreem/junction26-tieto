     7: [assembly: MsgPack::Internal.GeneratedAssemblyMessagePackResolverAttribute(typeof(MessagePack.GeneratedMessagePackResolver), 3, 0)]
     8: 
     9: namespace MessagePack {
    10: 
    11: /// &lt;summary&gt;A MessagePack resolver that uses generated formatters for types in this assembly.&lt;/summary&gt;
    12: partial class GeneratedMessagePackResolver : MsgPack::IFormatterResolver
    13: {
    14: 	/// &lt;summary&gt;An instance of this resolver that only returns formatters specifically generated for types in this assembly.&lt;/summary&gt;
    15: 	public static readonly MsgPack::IFormatterResolver Instance = new GeneratedMessagePackResolver();
    16: 
    17: 	private GeneratedMessagePackResolver()
    18: 	{
    19: 	}
    20: 
    21: 	public MsgPack::Formatters.IMessagePackFormatter&lt;T&gt; GetFormatter&lt;T&gt;()
    22: 	{
    23: 		return FormatterCache&lt;T&gt;.Formatter;
    24: 	}
    25: 
    26: 	private static class FormatterCache&lt;T&gt;
    27: 	{
    28: 		internal static readonly MsgPack::Formatters.IMessagePackFormatter&lt;T&gt; Formatter;
    29: 
    30: 		static FormatterCache()
    31: 		{
    32: 			var f = GeneratedMessagePackResolverGetFormatterHelper.GetFormatter(typeof(T));
    33: 			if (f != null)
    34: 			{
    35: 				Formatter = (MsgPack::Formatters.IMessagePackFormatter&lt;T&gt;)f;
    36: 			}
    37: 		}
    38: 	}
    39: 
    40: 	private static class GeneratedMessagePackResolverGetFormatterHelper
    41: 	{
    42: 		private static readonly global::System.Collections.Generic.Dictionary&lt;global::System.Type, int&gt; closedTypeLookup = new global::System.Collections.Generic.Dictionary&lt;global::System.Type, int&gt;(2)
    43: 		{
    44: 			{ typeof(global::MyEnum), 0 },
    45: 			{ typeof(global::MyMessagePackObject), 1 },
    46: 		};
    47: 
    48: 		internal static object GetFormatter(global::System.Type t)
    49: 		{
    50: 			if (closedTypeLookup.TryGetValue(t, out int closedKey))
    51: 			{
    52: 				switch (closedKey)
    53: 				{
    54: 					case 0: return new global::MessagePack.GeneratedMessagePackResolver.MyEnumFormatter();
    55: 					case 1: return new global::MessagePack.GeneratedMessagePackResolver.MyMessagePackObjectFormatter();
    56: 					default: return null; // unreachable
    57: 				};
    58: 			}
    59: 
    60: 			return null;
    61: 		}
    62: 	}
    63: }
