<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built once per source tree: dotnet build -p:MessagePackBin=<tree>/bin/MessagePack/Release/net8.0 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>CompatHarness</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MessagePack">
      <HintPath>$(MessagePackBin)/MessagePack.dll</HintPath>
    </Reference>
    <Reference Include="MessagePack.Annotations">
      <HintPath>$(MessagePackBin)/MessagePack.Annotations.dll</HintPath>
    </Reference>
    <!-- MessagePack.csproj references this with PrivateAssets=compile, so it is not in its bin. -->
    <PackageReference Include="Microsoft.NET.StringTools" Version="17.11.4" />
  </ItemGroup>
  <Target Name="RequireMessagePackBin" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(MessagePackBin)' == '' Or !Exists('$(MessagePackBin)/MessagePack.dll')"
           Text="Set -p:MessagePackBin to a folder containing MessagePack.dll (got '$(MessagePackBin)')." />
  </Target>
</Project>
