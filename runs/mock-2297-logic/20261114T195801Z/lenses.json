  "lens_interpretations": [
    {
      "label": "A",
      "summary": "Always-on, no setting. The templates unconditionally emit [global::System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage] on every generated formatter (int-key, string-key, enum, union) and on the generated resolver/composite resolver types and their nested helper classes, guarded only by a TFM #if. This is what the change implements, though the guard is inverted for enums and over-broad for netstandard2.0/.NET Framework.",
      "branch": ""
    },
    {
      "label": "B",
      "summary": "Same emission, but behind an opt-out setting the requirement explicitly allows. Add a bool option (for example GeneratorOptions/FormattersOptions.ExcludeFromCodeCoverage, default true, readable from an MSBuild/analyzer-config property such as build_property.MessagePackExcludeFromCodeCoverage and/or a GeneratedMessagePackResolver attribute argument). Each template wraps its `#if ... [ExcludeFromCodeCoverage] #endif` block in `<# if (Options.ExcludeFromCodeCoverage) { #> ... <# } #>`. Users who already decorate their resolver, or who want coverage of generated code, can turn it off, which avoids the CS0579 duplicate-attribute break.",
      "branch": ""
    }
  ],
