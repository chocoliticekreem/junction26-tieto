    42: 		private static readonly global::System.Collections.Generic.Dictionary&lt;global::System.Type, int&gt; closedTypeLookup = new global::System.Collections.Generic.Dictionary&lt;global::System.Type, int&gt;(3)
    43: 		{
    44: 			{ typeof(global::NS1.MyEnum), 0 },
    45: 			{ typeof(global::NS2.MyEnum), 1 },
    46: 			{ typeof(global::MyMessagePackObject), 2 },
    47: 		};
    48: 
    49: 		internal static object GetFormatter(global::System.Type t)
    50: 		{
    51: 			if (closedTypeLookup.TryGetValue(t, out int closedKey))
    52: 			{
    53: 				switch (closedKey)
    54: 				{
    55: 					case 0: return new global::MessagePack.GeneratedMessagePackResolver.NS1.MyEnumFormatter();
    56: 					case 1: return new global::MessagePack.GeneratedMessagePackResolver.NS2.MyEnumFormatter();
    57: 					case 2: return new global::MessagePack.GeneratedMessagePackResolver.MyMessagePackObjectFormatter();
    58: 					default: return null; // unreachable
    59: 				};
    60: 			}
    61: 
    62: 			return null;
    63: 		}
    64: 	}
    65: }
    66: 
    67: }
