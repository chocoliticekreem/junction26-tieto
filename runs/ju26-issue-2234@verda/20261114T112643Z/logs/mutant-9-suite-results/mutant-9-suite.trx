    45: 			{ typeof(global::System.Collections.Generic.List&lt;global::SubObject&gt;[]), 1 },
    46: 			{ typeof(global::System.Collections.Generic.List&lt;global::SubObject&gt;), 2 },
    47: 			{ typeof(global::ContainerObject), 3 },
    48: 			{ typeof(global::SubObject), 4 },
    49: 		};
    50: 
    51: 		internal static object GetFormatter(global::System.Type t)
    52: 		{
    53: 			if (closedTypeLookup.TryGetValue(t, out int closedKey))
    54: 			{
    55: 				switch (closedKey)
    56: 				{
    57: 					case 0: return new MsgPack::Formatters.ArrayFormatter&lt;global::SubObject&gt;();
    58: 					case 1: return new MsgPack::Formatters.ArrayFormatter&lt;global::System.Collections.Generic.List&lt;global::SubObject&gt;&gt;();
    59: 					case 2: return new MsgPack::Formatters.ListFormatter&lt;global::SubObject&gt;();
    60: 					case 3: return new global::MessagePack.GeneratedMessagePackResolver.ContainerObjectFormatter();
    61: 					case 4: return new global::MessagePack.GeneratedMessagePackResolver.SubObjectFormatter();
    62: 					default: return null; // unreachable
    63: 				};
    64: 			}
    65: 
    66: 			return null;
    67: 		}
    68: 	}
    69: }
    70: 
    71: }
