      <Output>
        <StdOut>--------------------------------------------------------------
MessagePack.SourceGenerator/MessagePack.SourceGenerator.CompositeResolverGenerator/MyResolver.g.cs
--------------------------------------------------------------
     1: 
     2: using MsgPack = global::MessagePack;
     3: 
     4: 
     5: partial class MyResolver : MsgPack::IFormatterResolver
     6: {
     7: 	public static readonly MyResolver Instance = new MyResolver();
     8: 
     9: 	private static readonly MsgPack::Formatters.IMessagePackFormatter[] formatterList = new MsgPack::Formatters.IMessagePackFormatter[]
    10: 	{
    11: 	};
    12: 
    13: 	private static readonly MsgPack::IFormatterResolver[] resolverList = new MsgPack::IFormatterResolver[]
    14: 	{
    15: 		global::MessagePack.Resolvers.NativeGuidResolver.Instance,
    16: 		new global::ResolverWithCtor(),
    17: 	};
    18: 
    19: 	private MyResolver() { }
    20: 
    21: 	public MsgPack::Formatters.IMessagePackFormatter&lt;T&gt; GetFormatter&lt;T&gt;()
    22: 	{
    23: 		return FormatterCache&lt;T&gt;.Formatter;
    24: 	}
    25: 
    26: 	static class FormatterCache&lt;T&gt;
    27: 	{
    28: 		internal static readonly MsgPack::Formatters.IMessagePackFormatter&lt;T&gt; Formatter;
    29: 
    30: 		static FormatterCache()
    31: 		{
    32: 			foreach (var formatter in formatterList)
    33: 			{
    34: 				if (formatter is MsgPack::Formatters.IMessagePackFormatter&lt;T&gt; f)
    35: 				{
    36: 					Formatter = f;
    37: 					return;
    38: 				}
    39: 			}
    40: 
    41: 			foreach (var resolver in resolverList)
    42: 			{
    43: 				var f = resolver.GetFormatter&lt;T&gt;();
    44: 				if (f != null)
    45: 				{
    46: 					Formatter = f;
    47: 					return;
    48: 				}
    49: 			}
    50: 		}
    51: 	}
    52: }
    53: 
    54: 
